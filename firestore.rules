rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidPresentation(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.userId == request.auth.uid &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
             data.description is string && data.description.size() <= 1000 &&
             data.languageCode is string && data.languageCode in ['AR', 'EN', 'FA', 'RU', 'IT', 'UR', 'ZH'] &&
             data.aspectRatioId is string && data.aspectRatioId.size() >= 1 && data.aspectRatioId.size() <= 32 &&
             data.themeId is string && data.themeId.size() >= 1 && data.themeId.size() <= 64 &&
             data.sourceType is string && data.sourceType.size() >= 1 && data.sourceType.size() <= 32 &&
             data.slideCount is int && data.slideCount >= 0 && data.slideCount <= 500 &&
             data.folderTag is string && data.folderTag.size() >= 1 && data.folderTag.size() <= 64 &&
             data.locked is bool &&
             data.deleted is bool &&
             data.payloadJson is string && data.payloadJson.size() >= 2 && data.payloadJson.size() <= 900000 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /users/{userId}/presentations/{presentationId} {
      allow get: if isOwner(userId) && isValidId(presentationId);
      allow list: if isOwner(userId);

      allow create: if isOwner(userId) &&
                       isValidId(presentationId) &&
                       incoming().keys().hasAll([
                         'userId', 'title', 'description', 'languageCode', 'aspectRatioId',
                         'themeId', 'sourceType', 'slideCount', 'folderTag', 'locked',
                         'deleted', 'payloadJson', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'title', 'description', 'languageCode', 'aspectRatioId',
                         'themeId', 'sourceType', 'slideCount', 'folderTag', 'locked',
                         'deleted', 'payloadJson', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidPresentation(incoming());

      allow update: if isOwner(userId) &&
                       isValidId(presentationId) &&
                       isValidPresentation(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'title', 'description', 'languageCode', 'aspectRatioId',
                         'themeId', 'sourceType', 'slideCount', 'folderTag', 'locked',
                         'deleted', 'payloadJson', 'updatedAt'
                       ]);

      allow delete: if isOwner(userId) && isValidId(presentationId);
    }
  }
}
